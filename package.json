{
  "name": "fotoshop",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "release": "node tools/make-release.js",
    "dist": "electron-builder",
    "publish": "electron-builder --publish always"
  },
  "build": {
    "appId": "com.anda.fotoshop",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "splash.html",
      "assets/**"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "USER",
        "repo": "REPO"
      }
    ],
    "productName": "Fotoshop"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  },
  "productName": "Fotoshop",
  "description": "Fotoshop - editor gambar",
  "author": "Fotoshop"
}